# Deterministic local development defaults. No credentials are required.
NEXO_DATA_DIR=./data
NEXO_MAX_UPLOAD_MB=15
NEXO_MODULES=attachments
NEXO_VECTOR_STORE=local

# Optional external integrations. Keep empty for deterministic tests.
NEXO_EMBEDDING_BASE_URL=
NEXO_EMBEDDING_API_KEY=
NEXO_EMBEDDING_MODEL=embedding-model
NEXO_QDRANT_URL=http://localhost:6333
NEXO_QDRANT_API_KEY=
NEXO_QDRANT_COLLECTION=nexo_chunks

# Optional modules: web-search-searxng, mcp, decision-runtime.
# NEXO_SEARXNG_URL=
# NEXO_MCP_SERVERS=[]
# NEXO_ARBITER_URL=
# NEXO_ARBITER_API_KEY=
